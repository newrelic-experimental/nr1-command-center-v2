 {
        "name": "Alert Quality Management",
        "pages": [
          {
            "name": "Alert Quality Management",
            "widgets": [
              {
                "layout": {
                  "column": 1,
                  "height": 2,
                  "row": 1,
                  "width": 2
                },
                "rawConfiguration": {
                  "facet": {
                    "showOtherSeries": false
                  },
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIncident SELECT count(*) AS 'Incident Count' WHERE event = 'open' AND priority = 'critical' SINCE 1 WEEK AGO COMPARE WITH 1 WEEK AGO"
                    }
                  ],
                  "platformOptions": {
                    "ignoreTimeRange": false
                  }
                },
                "title": "Incident Count",
                "visualization": {
                  "id": "viz.billboard"
                }
              },
              {
                "layout": {
                  "column": 3,
                  "height": 2,
                  "row": 1,
                  "width": 2
                },
                "rawConfiguration": {
                  "facet": {
                    "showOtherSeries": false
                  },
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIncident SELECT sum(durationSeconds)/60 AS 'Incident Minutes' WHERE event = 'close' AND priority = 'critical' SINCE 1 WEEK AGO COMPARE WITH 1 WEEK AGO "
                    }
                  ],
                  "platformOptions": {
                    "ignoreTimeRange": false
                  }
                },
                "title": "Closed Incident Minutes (Accumulated)",
                "visualization": {
                  "id": "viz.billboard"
                }
              },
              {
                "layout": {
                  "column": 5,
                  "height": 2,
                  "row": 1,
                  "width": 2
                },
                "rawConfiguration": {
                  "facet": {
                    "showOtherSeries": false
                  },
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIncident SELECT average(durationSeconds/60) AS 'Incident MTTC (minutes)' WHERE event = 'close' AND priority = 'critical' SINCE 1 WEEK AGO COMPARE WITH 1 WEEK AGO"
                    }
                  ],
                  "platformOptions": {
                    "ignoreTimeRange": false
                  }
                },
                "title": "Incident MTTC (minutes)",
                "visualization": {
                  "id": "viz.billboard"
                }
              },
              {
                "layout": {
                  "column": 7,
                  "height": 2,
                  "row": 1,
                  "width": 2
                },
                "rawConfiguration": {
                  "facet": {
                    "showOtherSeries": false
                  },
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIncident SELECT percentage(count(*), WHERE durationSeconds <= 5*60) AS '% Under 5min' WHERE event = 'close' AND priority = 'critical' SINCE 1 WEEK AGO COMPARE WITH 1 WEEK AGO "
                    }
                  ],
                  "platformOptions": {
                    "ignoreTimeRange": false
                  }
                },
                "title": "% Under 5min",
                "visualization": {
                  "id": "viz.billboard"
                }
              },
              {
                "layout": {
                  "column": 9,
                  "height": 2,
                  "row": 1,
                  "width": 2
                },
                "rawConfiguration": {
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIssue SELECT filter(count(*), WHERE event = 'acknowledge')/filter(count(*), WHERE event = 'create') * 100 as '% Investigated' WHERE priority = 'CRITICAL' SINCE 1 week ago COMPARE WITH 1 WEEK AGO"
                    }
                  ]
                },
                "title": "% Investigated ",
                "visualization": {
                  "id": "viz.billboard"
                }
              },
              {
                "layout": {
                  "column": 11,
                  "height": 2,
                  "row": 1,
                  "width": 2
                },
                "rawConfiguration": {
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIssue SELECT average(acknowledgeTime - activateTime)/60000 AS 'Incident MTTI (minutes)' WHERE event = 'acknowledge' SINCE 1 WEEK AGO COMPARE WITH 1 WEEK AGO"
                    }
                  ]
                },
                "title": "MTTI (minutes)",
                "visualization": {
                  "id": "viz.billboard"
                }
              },
              {
                "layout": {
                  "column": 1,
                  "height": 3,
                  "row": 3,
                  "width": 6
                },
                "rawConfiguration": {
                  "facet": {
                    "showOtherSeries": false
                  },
                  "nrqlQueries": [
                    {
                      "accountId": 1,
                      "query": "FROM NrAiIncident SELECT filter(count(*),WHERE event = 'open') AS 'Count', filter(sum(durationSeconds)/60,WHERE event = 'close') AS 'Minutes', average(durationSeconds/60) AS 'MTTC',filter(count(*), WHERE event = 'close' AND durationSeconds < 60)/filter(count(*), WHERE event = 'open')*100 AS '%<5min' WHERE priority = 'critical' SINCE 1 WEEK AGO FACET policyName LIMIT 100"
                    }
                  ],
                  "platformOptions": {
                    "ignoreTimeRange": false
                  }
                },
                "title": "Alerting Count by Policy",
                "visualization": {
                  "id": "viz.table"
                }
              },
